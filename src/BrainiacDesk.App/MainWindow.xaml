<Window x:Class="BrainiacDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Brand/BrainiacDesk.ico" Title="BrainiacDesk Ultimate" Width="1180" Height="780" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterScreen">
<Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Surface}" Padding="24"><DockPanel>
<ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"><StackPanel><Path Stroke="#F59E0B" StrokeThickness="3" Width="44" Height="36" HorizontalAlignment="Left" Stretch="Uniform" Data="M2,2 L42,2 42,30 2,30 Z M12,12 L18,12 18,20 12,20 Z M25,12 L31,12 31,20 25,20 Z M12,34 L32,34"/>
<TextBlock Text="BrainiacDesk" FontSize="23" FontWeight="Bold" Margin="0,18,0,0"/><TextBlock Text="ULTIMATE" Foreground="#F59E0B" FontSize="11" Margin="0,4,0,32"/>
<Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/><Button Content="File Converter" Click="OpenConverter"/><Button Content="Clipboard Shelf" Click="OpenShelf"/><Button Content="Teleprompter" Click="OpenTeleprompter"/><Button Content="Command Center" Click="OpenCommands"/><Button Content="File Toolkit" Tag="files" Click="OpenTool"/><Button Content="Workflow Studio" Tag="workflow" Click="OpenTool"/><Button Content="Screen Capture" Tag="capture" Click="OpenTool"/><Button Content="Workspaces" Tag="workspaces" Click="OpenTool"/><Button Content="Shortcuts" Click="OpenShortcuts"/><Button Content="Privacy / Diagnostics" Tag="privacy" Click="OpenTool"/><Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><Button Content="Help and tutorials" Command="{Binding NavigateCommand}" CommandParameter="Help"/><Button Content="About" Command="{Binding NavigateCommand}" CommandParameter="About"/>
</StackPanel></ScrollViewer><TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Text="LOCAL BY DESIGN&#10;One Desktop.&#10;Unlimited Possibilities." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></DockPanel></Border>
<Grid Grid.Column="1" Margin="36,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="YOUR EVERYDAY ADVANTAGE" Foreground="#F59E0B" FontSize="11"/><TextBlock Text="{Binding Page}" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,24"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
<Grid>
<StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource Visible}}"><TextBlock Text="Welcome to your desktop, organized." FontSize="26" TextWrapping="Wrap"/><TextBlock Text="BrainiacDesk is being built as an offline Windows utility. Choose utilities from the navigation. Work locally with files, snippets, scripts, and screenshots." TextWrapping="Wrap" Margin="0,20" FontSize="16"/><TextBlock Text="Your privacy starts here" FontSize="22"/><TextBlock Text="Clipboard monitoring is off. No analytics, account, or cloud connection is used. Startup integration is not enabled." TextWrapping="Wrap" Margin="0,12"/><Button Content="Get started" Command="{Binding CompleteWelcomeCommand}" HorizontalAlignment="Left"/></StackPanel>
<StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource Visible}}"><Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="28"><StackPanel><TextBlock Text="A calmer place to get things done." FontSize="26" TextWrapping="Wrap"/><TextBlock Text="Your settings stay on this PC. Choose your appearance and window behavior to make this space yours." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,14" FontSize="15"/><Button Content="Personalize your desk" Command="{Binding NavigateCommand}" CommandParameter="Settings" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock Text="Development build · 0.2.0" FontSize="20" Margin="0,28,0,12"/><TextBlock Text="Local conversion, clipboard snippets, teleprompter, file tools, command actions, manual workflows, workspaces, and capture annotations." TextWrapping="Wrap"/><TextBlock Text="Your tools are connected" FontSize="20" Margin="0,28,0,12"/><TextBlock Text="Open the File Converter, Clipboard Shelf, or Teleprompter from the navigation. Image conversions and PDF creation run locally." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel>
<StackPanel Visibility="{Binding IsSettings, Converter={StaticResource Visible}}"><TextBlock Text="Make yourself at home" FontSize="23"/><CheckBox Content="Use dark appearance (clear for light)" IsChecked="{Binding IsDark}"/><CheckBox Content="Send minimized windows to the system tray" IsChecked="{Binding MinimizeToTray}"/><CheckBox Content="Confirm before exiting" IsChecked="{Binding ConfirmExit}"/><Button Content="Save preferences" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/><TextBlock Text="Local data location" FontSize="20" Margin="0,28,0,12"/><TextBlock Text="{Binding DataLocation}" TextWrapping="Wrap"/><TextBlock Text="Clipboard monitoring starts disabled. Open Clipboard Shelf to grant session-only monitoring consent. Shelf content stays in memory." TextWrapping="Wrap" Margin="0,24" Foreground="{DynamicResource Muted}"/></StackPanel>
<StackPanel Visibility="{Binding IsHelp, Converter={StaticResource Visible}}"><TextBlock Text="Make the tools work together" FontSize="24"/><TextBlock Text="CONVERT&#10;Add or drop supported files, choose the output and folder, then run the queue. Existing outputs are preserved with numbered names. Review per-file results. PDF tools combine, split, extract, reorder, rotate and inspect pages.&#10;&#10;CLIPBOARD&#10;Add clipboard once or explicitly enable session monitoring. Content stays in memory. Search, pin, copy transformed text, save TXT, or send text to the teleprompter. Pause before copying secrets.&#10;&#10;TELEPROMPTER&#10;Import/paste a script, adjust reading preferences and start scrolling. Click the reading panel before using Space to pause or Home to restart. Capture exclusion is a Windows request and is not guaranteed.&#10;&#10;FILE TOOLKIT&#10;Verify hashes, inspect files, preview and confirm numbered renames, undo the last rename, scan duplicates without deletion, or create and safely extract ZIP files.&#10;&#10;WORKFLOWS&#10;Choose separate input/output folders and Copy, SHA-256 or ZIP steps. Dry-run selected files before confirming execution. These are manual workflows; no background watchers or schedules run.&#10;&#10;CAPTURE&#10;Choose a delay, focus the target window, and capture. Drag over the image to annotate or crop. Redaction flattens opaque black pixels into exports. Copy, save, export PDF or pin the image to the shelf.&#10;&#10;SHORTCUTS AND WORKSPACES&#10;Ctrl+Shift+Space opens Command Center if registration succeeds. Shortcut Studio handles conflicts. Workspaces save collections of BrainiacDesk tools.&#10;&#10;PRIVACY AND SUPPORT&#10;Privacy Center shows and clears activity, removes saved configurations and exports basic OS/runtime diagnostics. No accounts, telemetry or cloud processing. More offline guidance is in docs/HELP.md beside the source.&#10;&#10;Settings saves your appearance and window behavior. Tray double-click restores the window. Normal close exits with confirmation when enabled. See the readiness report for unimplemented features and pending Windows verification." TextWrapping="Wrap" FontSize="15" Margin="0,20"/></StackPanel>
<StackPanel Visibility="{Binding IsAbout, Converter={StaticResource Visible}}"><TextBlock Text="BrainiacDesk Ultimate" FontSize="28"/><TextBlock Text="One Desktop. Unlimited Possibilities." Foreground="#F59E0B" Margin="0,12"/><TextBlock Text="Developed by FRANCIS KUSI · BrainiacTech Hub&#10;Version 0.2.0 · Utility development build&#10;&#10;Native WPF · .NET 10 · Offline local storage&#10;&#10;This build is not certified for the Microsoft Store. Additional modules and release verification are pending." TextWrapping="Wrap" FontSize="16"/></StackPanel>
</Grid></ScrollViewer><TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,20,0,0"/>
</Grid></Grid></Window>