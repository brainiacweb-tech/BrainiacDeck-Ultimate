<StackPanel Visibility="{Binding IsActivity,Converter={StaticResource Visible}}"><TextBlock Text="Recent activity" Style="{StaticResource Heading}" FontSize="30"/><TextBlock Text="Your actual tool activity and saved operation results." Foreground="{DynamicResource Muted}" Margin="0,0,0,24"/><Border Style="{StaticResource Card}"><StackPanel><ItemsControl ItemsSource="{Binding ActivityItems}" ItemTemplate="{StaticResource ActivityRow}"/><TextBlock Text="{Binding DashboardData}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><Button Content="Open activity and diagnostics" Tag="privacy" Click="OpenTool" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border></StackPanel>
<StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource Visible}}" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Make room for better work." FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Your files, snippets, scripts and screenshots. One local toolkit." Foreground="{DynamicResource Muted}" FontSize="18" TextWrapping="Wrap" Margin="0,18,0,32"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Start with privacy on your side" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Clipboard monitoring starts off. No account, cloud connection, or analytics. You choose what to open and what to save." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,14,0,24"/><Button Content="Get started" Style="{StaticResource Primary}" Command="{Binding CompleteWelcomeCommand}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel>
<StackPanel Visibility="{Binding IsSettings, Converter={StaticResource Visible}}" MaxWidth="800" HorizontalAlignment="Left"><TextBlock Text="Make it yours." FontSize="34" FontWeight="SemiBold"/><TextBlock Text="A few preferences for a calmer workspace." Foreground="{DynamicResource Muted}" Margin="0,10,0,24"/><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Appearance &amp; window behavior" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="Use dark appearance (clear for light)" IsChecked="{Binding IsDark}"/><CheckBox Content="Send minimized windows to the system tray" IsChecked="{Binding MinimizeToTray}"/><CheckBox Content="Confirm before exiting" IsChecked="{Binding ConfirmExit}"/><Button Content="Brainiac Edge settings" Tag="edge-settings" Click="OpenTool" HorizontalAlignment="Left"/><Button Content="Save preferences" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Stored on this device" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding DataLocation}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,16"/><TextBlock Text="Clipboard monitoring needs separate session consent in Clipboard Shelf. Content stays in memory unless encrypted shelf persistence is explicitly enabled." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
<StackPanel Visibility="{Binding IsHelp,Converter={StaticResource Visible}}"><Border Background="{DynamicResource Hero}" CornerRadius="24" Padding="28" Margin="0,0,0,24"><StackPanel><Image Source="{DynamicResource Icon.Help}" Width="32" Height="32" HorizontalAlignment="Left" Margin="0,0,0,16"/><TextBlock Text="A little guidance. A lot of possibilities." Style="{StaticResource Heading}" FontSize="30" TextWrapping="Wrap"/><TextBlock Text="Help &amp; Tutorials" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,4,0,8"/><TextBlock Text="Pick a guide, follow the steps and open the tool when you’re ready. Everything below works locally." TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/></StackPanel></Border><WrapPanel><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource BlueCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Convert}" Width="25" Height="25"/></Border><TextBlock Text="Convert &amp; export" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="1. Add or drop supported files.&#10;2. Choose a format and destination folder.&#10;3. Run the queue and review each result.&#10;Existing outputs are preserved with numbered names." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Open Converter" Tag="convert" Click="OpenTool" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource LavenderCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Prompt}" Width="25" Height="25"/></Border><TextBlock Text="Present with confidence" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="1. Import, paste or write a script.&#10;2. Set your font, speed and reading guide.&#10;3. Start, pause or mirror the floating overlay.&#10;Use fullscreen for a distraction-free read." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Open Teleprompter" Tag="prompt" Click="OpenTool" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource PeachCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Capture}" Width="25" Height="25"/></Border><TextBlock Text="Capture an idea" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="1. Choose a delay and focus your target.&#10;2. Capture, then drag to crop or annotate.&#10;3. Copy, save, export PDF or pin the image.&#10;Redaction exports opaque black pixels." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Open Screen Capture" Tag="capture" Click="OpenTool" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource CyanCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Shelf}" Width="25" Height="25"/></Border><TextBlock Text="Your floating workspace" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="1. Open Brainiac Edge or use its screen edge.&#10;2. Drop files, add notes or pin clipboard content.&#10;3. Search, tag and organize by workspace.&#10;File references keep originals in place." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Open Brainiac Edge" Tag="edge" Click="OpenTool" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource MintCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Shelf}" Width="25" Height="25"/></Border><TextBlock Text="Keep useful snippets" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="1. Add the clipboard once, or consent to monitoring.&#10;2. Search, pin and copy transformed text.&#10;3. Save TXT or send text to Teleprompter.&#10;Pause monitoring before copying secrets." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Open Clipboard Shelf" Tag="shelf" Click="OpenTool" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource PinkCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Files}" Width="25" Height="25"/></Border><TextBlock Text="Organize your files" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="Verify hashes, preview numbered renames and undo the last rename. Scan duplicates without deletion, create ZIP archives or extract them safely. Always review the preview before changing files." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Open File Toolkit" Tag="files" Click="OpenTool" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource LavenderCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Workflow}" Width="25" Height="25"/></Border><TextBlock Text="Build a repeatable workflow" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="1. Choose separate input and output folders.&#10;2. Configure Copy, SHA-256 or ZIP steps.&#10;3. Dry-run selected files before executing.&#10;Workflows run manually; no schedules are active." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Open Workflows" Tag="workflow" Click="OpenTool" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource BlueCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Workspace}" Width="25" Height="25"/></Border><TextBlock Text="Bring your tools together" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="Create a workspace, name it and select your tools. Save the collection to reopen it later from Projects. Choose an Edge collection for the workspace to keep related pins together." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Open Workspaces" Tag="workspaces" Click="OpenTool" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource PeachCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Shortcuts}" Width="25" Height="25"/></Border><TextBlock Text="Keyboard shortcuts" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="Command Center: Ctrl+Shift+Space&#10;Teleprompter pause: Ctrl+Alt+P&#10;Restart: Ctrl+Alt+R · Dismiss: Ctrl+Alt+X&#10;Fullscreen: Ctrl+Alt+F&#10;Availability depends on shortcut conflicts." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Open Shortcut Studio" Click="OpenShortcuts" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource MintCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Privacy}" Width="25" Height="25"/></Border><TextBlock Text="Privacy &amp; troubleshooting" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="Review or clear activity and export basic OS/runtime diagnostics. Clipboard content stays in memory unless encrypted persistence is enabled. Capture exclusion is a Windows request and cannot be guaranteed." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Open Privacy Center" Tag="privacy" Click="OpenTool" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border></WrapPanel></StackPanel>
<StackPanel Visibility="{Binding IsAbout,Converter={StaticResource Visible}}"><Border Background="{DynamicResource Hero}" CornerRadius="24" Padding="32" Margin="0,0,0,24"><StackPanel><Image Source="Brand/BrainiacDeck-logo.png" Width="104" Height="104" HorizontalAlignment="Left" Margin="0,0,0,20"/><TextBlock Text="BrainiacDeck Ultimate" Style="{StaticResource Heading}" FontSize="32" TextWrapping="Wrap"/><TextBlock Text="One Desktop. Unlimited Possibilities." Foreground="{DynamicResource Accent}" FontSize="18" TextWrapping="Wrap" Margin="0,8,0,16"/><TextBlock Text="A native Windows workspace for presenting, creating and getting things done. Your scripts, files and ideas, together on your desktop." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="22" MaxWidth="650" HorizontalAlignment="Left"/></StackPanel></Border><WrapPanel><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource BlueCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Dashboard}" Width="25" Height="25"/></Border><TextBlock Text="Built for your desktop" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="Native Windows · WPF · .NET 10&#10;Version 0.2.0 · Development build" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource MintCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Privacy}" Width="25" Height="25"/></Border><TextBlock Text="Your work stays yours" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="Local processing, no account and no telemetry. You control clipboard consent, saved content and activity retention." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/><Button Content="Privacy controls" Tag="privacy" Click="OpenTool" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Arrow}"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource LavenderCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.About}" Width="25" Height="25"/></Border><TextBlock Text="Created with purpose" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="FRANCIS KUSI · BrainiacTech Hub&#10;A focused collection of tools for creators, presenters and everyday productivity." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="330" Margin="0,0,16,16" VerticalAlignment="Top"><StackPanel><Border Background="{DynamicResource PeachCard}" CornerRadius="14" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,16"><Image Source="{DynamicResource Icon.Help}" Width="25" Height="25"/></Border><TextBlock Text="Release &amp; support" Style="{StaticResource Heading}" FontSize="19"/><TextBlock Text="Development and release verification are ongoing. Microsoft Store certification is pending. Find practical step-by-step guides in Help &amp; Tutorials." TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource Muted}" Margin="0,4,0,16"/></StackPanel></Border></WrapPanel><Button Content="Explore Help &amp; Tutorials" Command="{Binding NavigateCommand}" CommandParameter="Help" Style="{StaticResource Primary}" HorizontalAlignment="Left" local:IconAssist.Source="{DynamicResource Icon.Nav.Help}"/></StackPanel>

