<Window x:Class="BrainiacDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Brand/BrainiacDesk.ico" Title="BrainiacDesk Ultimate" Width="1320" Height="900" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen">
<Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
<Grid Background="{DynamicResource Background}"><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,1,0"><Grid Margin="18,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Margin="12,0,0,24"><StackPanel Orientation="Horizontal"><Image Source="Brand/BrainiacDesk.ico" Width="32" Height="32" Margin="0,0,10,0"/><TextBlock Text="BrainiacDesk" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="YOUR DESKTOP TOOLKIT" Foreground="{DynamicResource Muted}" FontSize="10" Margin="42,4,0,0"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
<Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Navigation}"><Style.Triggers><DataTrigger Binding="{Binding IsDashboard}" Value="True"><Setter Property="Background" Value="{DynamicResource Background}"/><Setter Property="Foreground" Value="#F59E0B"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
<TextBlock Text="EVERYDAY TOOLS" Style="{StaticResource Caption}" Margin="14,14,0,6"/>
<Button Content="File Converter" Style="{StaticResource Navigation}" Click="OpenConverter"/><Button Content="Clipboard Shelf" Style="{StaticResource Navigation}" Click="OpenShelf"/><Button Content="Teleprompter" Style="{StaticResource Navigation}" Click="OpenTeleprompter"/><Button Content="Screen Capture" Style="{StaticResource Navigation}" Tag="capture" Click="OpenTool"/>
<TextBlock Text="ORGANIZE &amp; AUTOMATE" Style="{StaticResource Caption}" Margin="14,14,0,6"/>
<Button Content="File Toolkit" Style="{StaticResource Navigation}" Tag="files" Click="OpenTool"/><Button Content="Workflow Studio" Style="{StaticResource Navigation}" Tag="workflow" Click="OpenTool"/><Button Content="Workspaces" Style="{StaticResource Navigation}" Tag="workspaces" Click="OpenTool"/><Button Content="Shortcuts" Style="{StaticResource Navigation}" Click="OpenShortcuts"/>
<TextBlock Text="PREFERENCES" Style="{StaticResource Caption}" Margin="14,14,0,6"/><Button Content="Settings" Style="{StaticResource Navigation}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><Button Content="Privacy / Diagnostics" Style="{StaticResource Navigation}" Tag="privacy" Click="OpenTool"/><Button Content="Help and tutorials" Style="{StaticResource Navigation}" Command="{Binding NavigateCommand}" CommandParameter="Help"/><Button Content="About" Style="{StaticResource Navigation}" Command="{Binding NavigateCommand}" CommandParameter="About"/>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Padding="12,18,0,0" Margin="0,16,0,0"><StackPanel><TextBlock Text="LOCAL BY DESIGN" Foreground="#F59E0B" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Your files. Your device." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
</Grid></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1" Padding="32,0"><Grid><TextBlock Text="{Binding Page}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Command Center" Click="OpenCommands" HorizontalAlignment="Right" Width="215" Height="38" ToolTip="Search tools with Ctrl + Shift + Space"/></Grid></Border>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,20"><Grid>
<StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource Visible}}">
<TextBlock Text="A little less friction." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Everyday tools, together in one place." Foreground="{DynamicResource Muted}" FontSize="15" Margin="0,8,0,22"/>

<Grid Margin="0,0,0,14"><TextBlock Text="Your everyday essentials" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="4 TOOLS" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}"/></Grid>
<UniformGrid Columns="2" Margin="-6,0,-6,24"><Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><Grid><Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource Background}" HorizontalAlignment="Left"><Path Data="M2,10 L10,2 18,10 M10,2 L10,17 M4,20 L18,20" Stroke="#F59E0B" StrokeThickness="1.6" Stretch="Uniform" Width="22" Height="22"/></Border><TextBlock Text="01" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid><TextBlock Text="File Converter" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,7"/><TextBlock Text="Images, PDFs and local batch conversion." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,12"/><Button Content="Open converter" Click="OpenConverter"  HorizontalAlignment="Left" Margin="0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><Grid><Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource Background}" HorizontalAlignment="Left"><Path Data="M5,4 L18,4 18,22 3,22 3,4 M8,2 L14,2 14,7 8,7 Z" Stroke="#F59E0B" StrokeThickness="1.6" Stretch="Uniform" Width="22" Height="22"/></Border><TextBlock Text="02" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid><TextBlock Text="Clipboard Shelf" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,7"/><TextBlock Text="Temporary snippets, images and file references." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,12"/><Button Content="Open shelf" Click="OpenShelf"  HorizontalAlignment="Left" Margin="0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><Grid><Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource Background}" HorizontalAlignment="Left"><Path Data="M2,3 L22,3 22,17 2,17 Z M8,22 L16,22 M12,17 L12,22 M7,8 L17,8 M7,12 L14,12" Stroke="#F59E0B" StrokeThickness="1.6" Stretch="Uniform" Width="22" Height="22"/></Border><TextBlock Text="03" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid><TextBlock Text="Teleprompter" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,7"/><TextBlock Text="A floating script reader for your next presentation." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,12"/><Button Content="Open teleprompter" Click="OpenTeleprompter"  HorizontalAlignment="Left" Margin="0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><Grid><Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource Background}" HorizontalAlignment="Left"><Path Data="M8,2 L2,2 2,8 M16,2 L22,2 22,8 M22,16 L22,22 16,22 M8,22 L2,22 2,16 M7,7 L17,7 17,17 7,17 Z" Stroke="#F59E0B" StrokeThickness="1.6" Stretch="Uniform" Width="22" Height="22"/></Border><TextBlock Text="04" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid><TextBlock Text="Screen Capture" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,7"/><TextBlock Text="Crop, annotate and redact screenshots locally." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,12"/><Button Content="Open capture" Click="OpenTool" Tag="capture" HorizontalAlignment="Left" Margin="0"/></StackPanel></Border></UniformGrid>
<TextBlock Text="Build a better routine" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
<UniformGrid Columns="3" Margin="-6,0,-6,0"><Button Tag="files" Click="OpenTool" Margin="6" Padding="20" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="File Toolkit" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Rename, verify and organize." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button><Button Tag="workflow" Click="OpenTool" Margin="6" Padding="20" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="Workflow Studio" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Turn repeated steps into a routine." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button><Button Tag="workspaces" Click="OpenTool" Margin="6" Padding="20" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="Workspaces" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Bring your favorite tools together." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button></UniformGrid>
<Border BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,28,0,0"><TextBlock Text="One Desktop. Unlimited Possibilities." Foreground="{DynamicResource Muted}" FontSize="12"/></Border>
</StackPanel>
<StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource Visible}}" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Make room for better work." FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Your files, snippets, scripts and screenshots. One local toolkit." Foreground="{DynamicResource Muted}" FontSize="18" TextWrapping="Wrap" Margin="0,18,0,32"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Start with privacy on your side" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Clipboard monitoring starts off. No account, cloud connection, or analytics. You choose what to open and what to save." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,14,0,24"/><Button Content="Get started" Style="{StaticResource Primary}" Command="{Binding CompleteWelcomeCommand}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel>
<StackPanel Visibility="{Binding IsSettings, Converter={StaticResource Visible}}" MaxWidth="800" HorizontalAlignment="Left"><TextBlock Text="Make it yours." FontSize="34" FontWeight="SemiBold"/><TextBlock Text="A few preferences for a calmer workspace." Foreground="{DynamicResource Muted}" Margin="0,10,0,24"/><Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Appearance &amp; window behavior" FontSize="20" FontWeight="SemiBold"/><CheckBox Content="Use dark appearance (clear for light)" IsChecked="{Binding IsDark}"/><CheckBox Content="Send minimized windows to the system tray" IsChecked="{Binding MinimizeToTray}"/><CheckBox Content="Confirm before exiting" IsChecked="{Binding ConfirmExit}"/><Button Content="Save preferences" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Stored on this device" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding DataLocation}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,16"/><TextBlock Text="Clipboard monitoring needs separate session consent in Clipboard Shelf. Content stays in memory." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
<StackPanel Visibility="{Binding IsHelp, Converter={StaticResource Visible}}"><TextBlock Text="Make the tools work together" FontSize="24"/><TextBlock Text="CONVERT&#10;Add or drop supported files, choose the output and folder, then run the queue. Existing outputs are preserved with numbered names. Review per-file results. PDF tools combine, split, extract, reorder, rotate and inspect pages.&#10;&#10;CLIPBOARD&#10;Add clipboard once or explicitly enable session monitoring. Content stays in memory. Search, pin, copy transformed text, save TXT, or send text to the teleprompter. Pause before copying secrets.&#10;&#10;TELEPROMPTER&#10;Import/paste a script, adjust reading preferences and start scrolling. Click the reading panel before using Space to pause or Home to restart. Capture exclusion is a Windows request and is not guaranteed.&#10;&#10;FILE TOOLKIT&#10;Verify hashes, inspect files, preview and confirm numbered renames, undo the last rename, scan duplicates without deletion, or create and safely extract ZIP files.&#10;&#10;WORKFLOWS&#10;Choose separate input/output folders and Copy, SHA-256 or ZIP steps. Dry-run selected files before confirming execution. These are manual workflows; no background watchers or schedules run.&#10;&#10;CAPTURE&#10;Choose a delay, focus the target window, and capture. Drag over the image to annotate or crop. Redaction flattens opaque black pixels into exports. Copy, save, export PDF or pin the image to the shelf.&#10;&#10;SHORTCUTS AND WORKSPACES&#10;Ctrl+Shift+Space opens Command Center if registration succeeds. Shortcut Studio handles conflicts. Workspaces save collections of BrainiacDesk tools.&#10;&#10;PRIVACY AND SUPPORT&#10;Privacy Center shows and clears activity, removes saved configurations and exports basic OS/runtime diagnostics. No accounts, telemetry or cloud processing. More offline guidance is in docs/HELP.md beside the source.&#10;&#10;Settings saves your appearance and window behavior. Tray double-click restores the window. Normal close exits with confirmation when enabled. See the readiness report for unimplemented features and pending Windows verification." TextWrapping="Wrap" FontSize="15" Margin="0,20"/></StackPanel>
<StackPanel Visibility="{Binding IsAbout, Converter={StaticResource Visible}}" MaxWidth="760" HorizontalAlignment="Left"><Image Source="Brand/BrainiacDesk.ico" Width="80" Height="80" HorizontalAlignment="Left" Margin="0,0,0,24"/><TextBlock Text="BrainiacDesk Ultimate" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="One Desktop. Unlimited Possibilities." Foreground="#F59E0B" FontSize="18" Margin="0,12,0,28"/><Border Style="{StaticResource Card}"><TextBlock Text="FRANCIS KUSI · BrainiacTech Hub&#10;&#10;Version 0.2.0 · Development build&#10;Native Windows · .NET 10 · Local processing&#10;&#10;Additional features and release verification remain in progress. Microsoft Store certification is pending." TextWrapping="Wrap" FontSize="15"/></Border></StackPanel>
</Grid></ScrollViewer>
<Border Grid.Row="2" Padding="32,12" BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></Border>
</Grid></Grid></Window>