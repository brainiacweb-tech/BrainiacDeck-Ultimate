<Window x:Class="BrainiacDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BrainiacDesk Ultimate" Width="1180" Height="780" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterScreen">
<Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Surface}" Padding="24"><DockPanel>
<StackPanel DockPanel.Dock="Top"><Path Stroke="#F59E0B" StrokeThickness="3" Width="44" Height="36" HorizontalAlignment="Left" Stretch="Uniform" Data="M2,2 L42,2 42,30 2,30 Z M12,12 L18,12 18,20 12,20 Z M25,12 L31,12 31,20 25,20 Z M12,34 L32,34"/>
<TextBlock Text="BrainiacDesk" FontSize="23" FontWeight="Bold" Margin="0,18,0,0"/><TextBlock Text="ULTIMATE" Foreground="#F59E0B" FontSize="11" Margin="0,4,0,32"/>
<Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/><Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><Button Content="Help and tutorials" Command="{Binding NavigateCommand}" CommandParameter="Help"/><Button Content="About" Command="{Binding NavigateCommand}" CommandParameter="About"/>
</StackPanel><TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Text="LOCAL BY DESIGN&#10;One Desktop.&#10;Unlimited Possibilities." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></DockPanel></Border>
<Grid Grid.Column="1" Margin="36,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="YOUR EVERYDAY ADVANTAGE" Foreground="#F59E0B" FontSize="11"/><TextBlock Text="{Binding Page}" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,24"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
<Grid>
<StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource Visible}}"><TextBlock Text="Welcome to your desktop, organized." FontSize="26" TextWrapping="Wrap"/><TextBlock Text="BrainiacDesk is being built as an offline Windows utility. This foundation release includes appearance preferences, local settings, and tray controls." TextWrapping="Wrap" Margin="0,20" FontSize="16"/><TextBlock Text="Your privacy starts here" FontSize="22"/><TextBlock Text="Clipboard monitoring is off. No analytics, account, or cloud connection is used. Startup integration is not enabled." TextWrapping="Wrap" Margin="0,12"/><Button Content="Get started" Command="{Binding CompleteWelcomeCommand}" HorizontalAlignment="Left"/></StackPanel>
<StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource Visible}}"><Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="28"><StackPanel><TextBlock Text="A calmer place to get things done." FontSize="26" TextWrapping="Wrap"/><TextBlock Text="Your settings stay on this PC. Choose your appearance and window behavior to make this space yours." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,14" FontSize="15"/><Button Content="Personalize your desk" Command="{Binding NavigateCommand}" CommandParameter="Settings" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock Text="Foundation release · 0.1.0" FontSize="20" Margin="0,28,0,12"/><TextBlock Text="Available now: persistent preferences, light and dark themes, first-run setup, and system tray controls." TextWrapping="Wrap"/><TextBlock Text="Next milestone" FontSize="20" Margin="0,28,0,12"/><TextBlock Text="File conversion, Clipboard Shelf, and the floating teleprompter are planned. They are not included in this build." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel>
<StackPanel Visibility="{Binding IsSettings, Converter={StaticResource Visible}}"><TextBlock Text="Make yourself at home" FontSize="23"/><CheckBox Content="Use dark appearance (clear for light)" IsChecked="{Binding IsDark}"/><CheckBox Content="Send minimized windows to the system tray" IsChecked="{Binding MinimizeToTray}"/><CheckBox Content="Confirm before exiting" IsChecked="{Binding ConfirmExit}"/><Button Content="Save preferences" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/><TextBlock Text="Local data location" FontSize="20" Margin="0,28,0,12"/><TextBlock Text="{Binding DataLocation}" TextWrapping="Wrap"/><TextBlock Text="Clipboard monitoring is disabled. No clipboard content is read or stored in this release." TextWrapping="Wrap" Margin="0,24" Foreground="{DynamicResource Muted}"/></StackPanel>
<StackPanel Visibility="{Binding IsHelp, Converter={StaticResource Visible}}"><TextBlock Text="Getting started" FontSize="24"/><TextBlock Text="1. Open Settings, choose your theme and window behavior, then save.&#10;&#10;2. Minimize to keep BrainiacDesk in the tray when enabled. Double-click the tray icon to restore it.&#10;&#10;3. Use Exit in the tray menu to close the application. The title-bar close button also exits.&#10;&#10;4. Settings are saved locally in a SQLite database and restored on the next launch.&#10;&#10;Troubleshooting: if storage cannot be opened, the application reports the error without resetting your settings. Check that your local application data folder is writable." TextWrapping="Wrap" FontSize="16" Margin="0,20"/></StackPanel>
<StackPanel Visibility="{Binding IsAbout, Converter={StaticResource Visible}}"><TextBlock Text="BrainiacDesk Ultimate" FontSize="28"/><TextBlock Text="One Desktop. Unlimited Possibilities." Foreground="#F59E0B" Margin="0,12"/><TextBlock Text="Developed by FRANCIS KUSI · BrainiacTech Hub&#10;Version 0.1.0 · Foundation development build&#10;&#10;Native WPF · .NET 10 · Offline local storage&#10;&#10;This build is not certified for the Microsoft Store. Additional modules and release verification are pending." TextWrapping="Wrap" FontSize="16"/></StackPanel>
</Grid></ScrollViewer><TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,20,0,0"/>
</Grid></Grid></Window>