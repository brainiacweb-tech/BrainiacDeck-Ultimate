<Window x:Class="BrainiacDesk.App.EdgeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Brainiac Edge" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Width="900" Height="500" AllowDrop="True" AutomationProperties.Name="Brainiac Edge workspace">
<Window.Resources><BooleanToVisibilityConverter x:Key="Bool"/></Window.Resources>
<Border x:Name="Frame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="0,0,24,24" Padding="20"><Border.RenderTransform><TranslateTransform x:Name="Motion"/></Border.RenderTransform>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="BRAINIAC EDGE" FontFamily="{StaticResource AppFont}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Your floating workspace" Foreground="{DynamicResource Muted}" Margin="0,4,20,8"/></StackPanel><WrapPanel HorizontalAlignment="Right"><CheckBox x:Name="StayOpen" Content="Keep open" VerticalAlignment="Center" Margin="8"/><Button Content="_Add" Click="AddClick"/><Button Content="_Settings" Click="SettingsClick"/><Button Content="_Hide" Click="HideClick"/></WrapPanel></DockPanel>
<Grid Grid.Row="1" Margin="0,8,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search titles, tags, content and OCR text" AutomationProperties.Name="Search pinned content"/><TextBlock Text="Search titles, tags and text…" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ComboBox x:Name="WorkspaceBox" Grid.Column="1" Margin="8,0" DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="Workspace collection"/><ComboBox x:Name="KindBox" Grid.Column="2" ToolTip="Content type"/><CheckBox Grid.Column="3" Content="Favourites" IsChecked="{Binding FavouritesOnly}" Margin="10" VerticalAlignment="Center"/></Grid>
<Grid Grid.Row="2"><ListBox x:Name="Pins" ItemsSource="{Binding Items}" SelectionMode="Extended" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Pinned content">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="0,3"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Outline" BorderThickness="1" BorderBrush="{DynamicResource Edge}" Background="{DynamicResource Surface}" CornerRadius="10" Padding="10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Outline" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="{Binding RelativeSource={RelativeSource AncestorType=Window},Path=ThumbnailSize}" Height="{Binding RelativeSource={RelativeSource AncestorType=Window},Path=ThumbnailSize}" CornerRadius="8" Background="{DynamicResource Background}" Margin="0,0,14,0"><Grid><TextBlock Text="{Binding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><Image Loaded="ThumbnailLoaded" Unloaded="ThumbnailUnloaded" DataContextChanged="ThumbnailDataChanged" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Content}" MaxHeight="40" TextWrapping="Wrap" Margin="0,5" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/><WrapPanel><TextBlock Text="{Binding Tags}" Foreground="{DynamicResource Accent}"/><TextBlock Text="  ★" Visibility="{Binding Favourite,Converter={StaticResource Bool}}"/><TextBlock Text="  Pinned" Visibility="{Binding Pinned,Converter={StaticResource Bool}}"/></WrapPanel></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<TextBlock Text="Keep useful things within reach.&#10;Add a note or drop files, images and text." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource Muted}" Visibility="{Binding IsEmpty,Converter={StaticResource Bool}}" IsHitTestVisible="False"/></Grid>
<ProgressBar Grid.Row="2" Height="2" VerticalAlignment="Top" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource Bool}}"/>
<Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Margin="16,0,0,0" Text="Enter · open   Ctrl+C · copy   Esc · hide" FontSize="11" Foreground="{DynamicResource Muted}"/></Grid>
</Grid></Border></Window>
