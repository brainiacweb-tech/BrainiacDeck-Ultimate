<Application x:Class="BrainiacDesk.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
<Application.Resources>
<SolidColorBrush x:Key="Background" Color="#101827"/><SolidColorBrush x:Key="Surface" Color="#182438"/><SolidColorBrush x:Key="Ink" Color="#FFFFFF"/><SolidColorBrush x:Key="Muted" Color="#AAB6C5"/><SolidColorBrush x:Key="Edge" Color="#304054"/>
<Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource Background}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
<Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Edge}"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,12"/></Style>
</Application.Resources></Application>